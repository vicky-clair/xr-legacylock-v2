{
  "name": "legacylock-tauri",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "tauri": "tauri",
    "package:preview": "tauri build --config src-tauri/tauri.preview.conf.json --bundles nsis --ci -- --locked",
    "test:interop": "cargo build -p vault-core --example interop --locked && node --test tests/interoperability/protocol.cjs",
    "test:reference": "node --test reference/legacy/tests/*.test.cjs",
    "package:offline": "tauri build --config src-tauri/tauri.preview.conf.json --config src-tauri/tauri.offline.conf.json --bundles nsis --ci -- --locked"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "0.475.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
